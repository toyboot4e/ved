{
  "name": "@ved/root",
  "version": "0.1.0",
  "private": true,
  "description": "ved monorepo — workspace root (no shipped code).",
  "workspaces": ["editor", "desktop", "vim", "web"],
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "check:fix:unsafe": "biome check --fix --unsafe",
    "format": "biome format",
    "format:fix": "biome format --fix",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd editor typecheck && bun run --cwd vim typecheck && bun run --cwd desktop typecheck && bun run --cwd web typecheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "dev": "bun run --cwd desktop dev",
    "dev:web": "bun run --cwd web dev",
    "start": "bun run --cwd desktop start",
    "build": "bun run --cwd desktop build",
    "build:web": "bun run --cwd web build",
    "smoke": "bun run --cwd desktop smoke",
    "smoke:mozc": "bun run --cwd desktop smoke:mozc",
    "api-docs": "vite build --config vite.docs.config.ts",
    "api-docs:serve": "vite --config vite.docs.config.ts --open"
  },
  "trustedDependencies": ["electron", "node-pty"],
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@ox-content/napi": "^2.90.0",
    "@ox-content/vite-plugin": "2.90.0",
    "@types/node": "^26.4.0",
    "node-gyp": "^13.0.2",
    "@vitest/ui": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "prosemirror-view": "^1.42.3"
  }
}
